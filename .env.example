# Copy to .env and fill in. Never commit .env.
# Public (safe in the browser) — your database project URL and publishable/anon key:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (NEVER prefix with VITE_, never used in browser code):
SUPABASE_SERVICE_ROLE_KEY=
# Optional: URL of a Python GARCH/LSTM forecasting service
ML_FORECAST_API_URL=
ML_FORECAST_API_KEY=
